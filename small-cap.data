name":"dir","type":"string","value":"down"}]},{"id":2,"name":"east","type":"spawn","x":592,"y":192,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"dir","type":"string","value":"left"}]},{"id":3,"name":"","type":"warp","x":624,"y":192,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"map","type":"string","value":"woods"},{"name":"spawn","type":"string","value":"west"}]},{"id":4,"name":"","type":"npc","x":320,"y":176,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"npc","type":"string","value":"elder"},{"name":"give","type":"string","value":"sword"},{"name":"afterIf","type":"string","value":"got_sword"},{"name":"text","type":"string","value":"Bram: Ah, Pip! And Capo too, I see.|Capo: Morning, Elder Bram!|Bram: I'm afraid I have grim news. The Sunstone that warms the Rootwood has gone dark.|Bram: Without its light, blobs and beetles have overrun the woods east of the village.|Bram: Folk say the tiny Thimblings guard the stone, deep beneath the old stump. Far too small for us big folk...|Capo: Ahem! Too small for big folk. Not for a hero with a magic hat!|Bram: Ho ho! Then you'll need this. It's old, but it's sharp."},{"name":"after","type":"string","value":"Bram: The Rootwood lies to the east. Find the old shrink stump, and let Capo do the rest. Be careful, Pip!"}]},{"id":5,"name":"","type":"npc","x":592,"y":192,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"npc","type":"string","value":"guard"},{"name":"moveIf","type":"string","value":"got_sword"},{"name":"moveX","type":"string","value":"36"},{"name":"moveY","type":"string","value":"10"},{"name":"afterIf","type":"string","value":"got_sword"},{"name":"text","type":"string","value":"Guard: Halt, Pip! The Rootwood is crawling with monsters.|Guard: Nobody goes east without a blade. Go see Elder Bram in the square."},{"name":"after","type":"string","value":"Guard: That's Bram's old sword! Off you go then - and watch out for beetles!"}]},{"id":6,"name":"","type":"npc","x":400,"y":144,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"npc","type":"string","value":"mira"},{"name":"text","type":"string","value":"Mira: Morning, Pip! Did you know? Cutting bushes and smashing pots sometimes turns up gems.|Mira: Hearts too, if you're feeling bruised. Just don't tell the gardener!"}]},{"id":7,"name":"","type":"npc","x":192,"y":240,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"npc","type":"string","value":"tobi"},{"name":"wander","type":"string","value":"true"},{"name":"text","type":"string","value":"Tobi: I saw a glowing stump in the woods! When I stood on it, my hat tingled.|Tobi: Mom says I'm not allowed to go back there. But you have a talking hat!"}]},{"id":8,"name":"","type":"sign","x":560,"y":224,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"text","type":"string","value":"East: the Rootwood.\nWest: Hearthwood Village."}]},{"id":9,"name":"","type":"sign","x":256,"y":128,"width":16,"height":16,"rotation":0,"visible":true,"properties":[{"name":"text","type":"string","value":"Hearthwood Village Square.\nPlease keep off the flowers."}]},{"id":10,"name":"","type":"bush","x":48,"y":144,"width":16,"height":16,"rotation":0,"visible":true},{"id":11,"name":"","type":"bush","x":64,"y":144,"width":16,"height":16,"rotation":0,"visible":true},{"id":12,"name":"","type":"bush","x":160,"y":128,"width":16,"height":16,"rotation":0,"visible":true},{"id":13,"name":"","type":"bush","x":160,"y":144,"width":16,"height":16,"rotation":0,"visible":true},{"id":14,"name":"","type":"bush","x":368,"y":112,"width":16,"height":16,"rotation":0,"visible":true},{"id":15,"name":"","type":"bush","x":384,"y":112,"width":16,"height":16,"rotation":0,"visible":true},{"id":16,"name":"","type":"bush","x":144,"y":352,"width":16,"height":16,"rotation":0,"visible":true},{"id":17,"name":"","type":"bush","x":160,"y":352,"width":16,"height":16,"rotation":0,"v