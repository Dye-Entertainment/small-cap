}layout(location = 0) in vec3 aPosition;
layout(location = 1) in vec3 aNormal;
layout(location = 2) in vec2 aTexCoord;
layout(location = 3) in ivec4 aBoneIds;
layout(location = 4) in vec4 aWeights;

const int MAX_BONES = 100;
const int MAX_BONE_INFLUENCE = 4;

uniform mat4 uModel;
#include "engine://shaders/camera_data.glsl"

uniform mat4 uFinalBonesMatrices[MAX_BONES];

out VS_OUT
{
    vec3 FragmentPosition;
    vec2 TexCoords;
    vec3 TangentViewPosition;
    vec3 TangentFragmentPosition;
    vec3 Normal;
    vec4 FragmentPositionLightSpace;
}
vs_out;

void main()
{
    vec4 skinnedPos = vec4(0.0);
    vec3 skinnedNorm = vec3(0.0);

    for (int i = 0; i < MAX_BONE_INFLUENCE; ++i)
    {
        const int boneId = aBoneIds[i];
        const float weight = aWeights[i];

        if (boneId < 0 || boneId >= MAX_BONES || weight <= 0.0)
            continue;

        const mat4 boneMatrix = uFinalBonesMatrices[boneId];

        skinnedPos += boneMatrix * vec4(aPosition, 1.0) * weight;
        skinnedNorm += mat3(boneMatrix) * aNormal * weight;
    }

    vs_out.FragmentPosition = (uModel * vec4(aPosition, 1.0)).rgb;
    vs_out.TexCoords = aTexCoord;

    gl_Position = uProjection * uView * uModel * skinnedPos;
}
out vec4 oFragColor;

