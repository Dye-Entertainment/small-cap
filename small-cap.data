4hQ¡ý␀␀␀␀ÚïªH€␀␀␀␀‡N:÷¾{ï¾yç~y×}õß\õ×<óÇ<ïÇñ¾Ûï¶Ûk␀␀
«¾Û®␀␀wvSLóÏ,óÇ,±Ë1Ç0Á1APE$QI$’M$”MAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA␀º¢in vec2 TexCoords;

out vec4 FragColor;

struct Material
{
    sampler2D diffuse;
};

uniform Material uMaterial;
uniform vec4 uTint;
// 0..1: mixes the colour toward white (hit flash).
uniform float uFlash;
// 0..1: global brightness, used for fades.
uniform float uBright;
void main()
{
    vec4 color = texture(uMaterial.diffuse, TexCoords);
    if (color.a < 0.5)
    {
        discard;
    }
    color *= uTint;
    vec3 rgb = mix(color.rgb, vec3(1.0), uFlash) * uBright;
    // Alpha only matters for blend materials (translucent tints); opaque ones ignore it.
    FragColor = vec4(rgb, color.a);
}
{
	"vertex": "game://shaders/sprite.vs",
	"fragment": "game://shaders/sprite.fs"
}
layout(location = 0) in vec3 aPosition;
layout(location = 1) in vec2 aTexCoord;

#include "engine://shaders/camera_data.glsl"

out vec2 TexCoords;
uniform mat4 uModel;

void main()
{
    gl_Position = uProjection * uView * uModel * vec4(aPosition, 1.0);
    TexCoords = aTexCoord;
}
