	"vertex": "engine://shaders/gltf/3d_lit.vs",
	"fragment": "engine://shaders/gltf/3d_lit.fs"
}layout(location = 0) in vec3 aPosition;
layout(location = 1) in vec3 aNormal;
layout(location = 2) in vec2 aTexCoords;
layout(location = 3) in vec3 aTangent;

#include "engine://shaders/camera_data.glsl"

out VS_OUT
{
    vec3 FragmentPosition;
    vec2 TexCoords;
    vec3 TangentViewPosition;
    vec3 TangentFragmentPosition;
    vec3 Normal;
    vec4 FragmentPositionLightSpace;
}
vs_out;

uniform mat4 uModel;
uniform mat4 uLightSpaceMatrix;

void main()
{
    vs_out.FragmentPosition = vec3(uModel * vec4(aPosition, 1.0));
    vs_out.TexCoords = aTexCoords;
    vs_out.FragmentPositionLightSpace =
        uLightSpaceMatrix * vec4(vs_out.FragmentPosition, 1.0);

    mat3 normal_matrix = transpose(inverse(mat3(uModel)));

    vec3 tangent = normalize(normal_matrix * aTangent);
    vs_out.Normal = normalize(normal_matrix * aNormal);

    // Orthogonalize tangent against normal
    tangent = normalize(
        tangent - dot(tangent, vs_out.Normal) * vs_out.Normal
    );

    vec3 bitangent = cross(vs_out.Normal, tangent);

    // World space -> tangent space
    mat3 TBN = transpose(mat3(tangent, bitangent, vs_out.Normal));

    // Camera position relative to the fragment
    vec3 viewDirection =
        uViewPosition - vs_out.FragmentPosition;

    vs_out.TangentViewPosition = TBN * viewDirection;

    gl_Position =
        uProjection *
        uView *
        uModel *
        vec4(aPosition, 1.0);
}
