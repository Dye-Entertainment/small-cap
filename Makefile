# Convenience targets. Requires clang, cmake >= 3.28 and ninja; the web target also needs emsdk
# (EMSDK env var, or ~/emsdk). Assets are generated by python3 (standard library only) and ffmpeg.
SHELL := /bin/bash
ROOT := $(abspath .)
EMSDK ?= $(HOME)/emsdk
LINUX_TOOLCHAIN := $(ROOT)/evogine/src/platform/linux/toolchain/clang-toolchain.cmake
WEB_TOOLCHAIN := $(ROOT)/evogine/src/platform/emscripten/toolchain/emscripten.cmake
CONFIGURATION ?= Release

.PHONY: all submodules evogen assets linux web run pages deploy clean

all: linux

submodules:
	@if [ ! -f evogine/src/evogine.cmake ]; then git submodule update --init --recursive; fi

# The engine's ECS/resource code generator. Needed once before the first configure.
evogen: submodules
	@if [ -x evogine/tools/evogen/bin/evogen ]; then echo "evogen present"; else \
	cmake -S evogine/tools/evogen -G Ninja -B build-evogen --toolchain=$(LINUX_TOOLCHAIN) \
		-DCMAKE_BUILD_TYPE=Release && ninja -C build-evogen; fi

# Regenerates every sprite, tile, map, sound effect and music track from tools/.
assets:
	python3 tools/make_art.py resources/textures
	python3 tools/make_maps.py resources/maps
	python3 tools/make_audio.py resources
	python3 tools/make_ui.py resources

linux: evogen
	cmake -S . -G Ninja -B build-linux --toolchain=$(LINUX_TOOLCHAIN) -DCMAKE_BUILD_TYPE=$(CONFIGURATION)
	ninja -C build-linux

run: linux
	./build-linux/$(CONFIGURATION)/small-cap

web: evogen
	source $(EMSDK)/emsdk_env.sh >/dev/null 2>&1 && \
	cmake -S . -G Ninja -B build-web --toolchain=$(WEB_TOOLCHAIN) -DCMAKE_BUILD_TYPE=$(CONFIGURATION) && \
	ninja -C build-web

# Packages the web build into ./site for GitHub Pages.
pages: web
	rm -rf site && mkdir -p site
	cp build-web/small-cap.html site/index.html
	cp build-web/small-cap.js build-web/small-cap.wasm build-web/small-cap.data site/
	touch site/.nojekyll

# Publishes ./site to the gh-pages branch of origin.
deploy: pages
	tools/deploy_pages.sh

clean:
	rm -rf build-linux build-web site
